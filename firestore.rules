rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function hasAllKeys(data, keys) { return data.keys().hasAll(keys) && data.keys().size() == keys.size(); }

    // Tier 1: System Administrator
    function isSystemAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'cculp@asheboro.k12.nc.us',
          'jwhancock@asheboro.k12.nc.us',
          'aseagraves@asheboro.k12.nc.us'
        ]) || 
        (request.auth.token.email != null && exists(/databases/$(database)/documents/system_admins/$(request.auth.token.email.lower())))
      );
    }

    match /system_admins/{email} {
      allow get, list: if isSignedIn();
      allow write: if isSystemAdmin();
    }

    // Role assigned to this specific student
    function getUserRole(studentData) {
      return studentData.get('userRoles', {}).get(request.auth.token.email.lower(), 'none');
    }

    // Tier 2: Case Manager (Can modify student settings/behaviors)
    function isCaseManager(studentData) {
      return isSystemAdmin() || getUserRole(studentData) == 'edit';
    }

    // Tier 3: Contributor (Can record data)
    function canLogData(studentData) {
      return isSystemAdmin() || 
             getUserRole(studentData) in ['edit', 'view'] ||
             studentData.get('teacherEmails', []).hasAny([request.auth.token.email.lower()]);
    }

    function isOwnerOrShared(studentData) {
      return canLogData(studentData);
    }

    function isValidStudent(data) {
      return
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        (!('gradeLevel' in data) || (data.gradeLevel is string && data.gradeLevel.size() <= 200)) &&
        (!('homeroomTeacher' in data) || (data.homeroomTeacher is string && data.homeroomTeacher.size() <= 200)) &&
        (!('groups' in data) || (data.groups is list && data.groups.size() <= 100)) &&
        (!('status' in data) || (data.status is string && (data.status == 'active' || data.status == 'archived'))) &&
        (!('behaviors' in data) || (data.behaviors is list && data.behaviors.size() <= 100)) &&
        (!('schedule' in data) || (data.schedule is list && data.schedule.size() <= 100)) &&
        (!('teacherEmails' in data) || (data.teacherEmails is list && data.teacherEmails.size() <= 200)) &&
        (!('ownerId' in data) || (data.ownerId is string && data.ownerId.size() <= 128)) &&
        (!('userRoles' in data) || (data.userRoles is map && data.userRoles.size() <= 100)) &&
        (!('authorizedUsers' in data) || (data.authorizedUsers is list && data.authorizedUsers.size() <= 100));
    }

    function isValidPersonalGroup(data) {
      return
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.ownerId is string && data.ownerId.size() <= 128 &&
        data.studentIds is list && data.studentIds.size() <= 1000 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidDailyLog(data) {
      return
        data.date is string && data.date.size() == 10 &&
        data.attendance is string && data.attendance.size() <= 20 &&
        data.periodData is string && data.periodData.size() <= 10000 &&
        data.createdAt is string && data.createdAt.size() <= 50 &&
        data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    function isValidDailyNote(data) {
      return
        data.date is string && data.date.size() == 10 &&
        data.text is string && data.text.size() <= 10000 &&
        data.updatedAt is string && data.updatedAt.size() <= 50;
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return
        data.email is string && data.email.size() <= 100 &&
        data.createdAt is string && data.createdAt.size() <= 50;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId &&
                       isValidId(userId) &&
                       hasAllKeys(incoming(), ['email', 'createdAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email']) &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && isOwnerOrShared(existing());
      allow list: if isSignedIn() && isOwnerOrShared(resource.data);
      allow create: if isSystemAdmin() &&
                       isValidId(studentId) &&
                       isValidStudent(incoming());
      allow update: if (isSystemAdmin() || isCaseManager(existing())) &&
                       isValidStudent(incoming()) &&
                       (isSystemAdmin() || !incoming().diff(existing()).affectedKeys().hasAny(['name', 'gradeLevel', 'homeroomTeacher', 'teacherEmails', 'userRoles', 'authorizedUsers', 'status', 'ownerId']));
      allow delete: if isSystemAdmin();

      match /logs/{logId} {
        allow read: if isSignedIn() && isOwnerOrShared(get(/databases/$(database)/documents/students/$(studentId)).data);
        allow list: if isSignedIn() && isOwnerOrShared(get(/databases/$(database)/documents/students/$(studentId)).data);
        allow create: if isSignedIn() && canLogData(get(/databases/$(database)/documents/students/$(studentId)).data) &&
                         isValidId(logId) &&
                         hasAllKeys(incoming(), ['date', 'attendance', 'periodData', 'createdAt', 'updatedAt']) &&
                         isValidDailyLog(incoming());
        allow update: if isSignedIn() && canLogData(get(/databases/$(database)/documents/students/$(studentId)).data) &&
                         isValidDailyLog(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['attendance', 'periodData', 'updatedAt']) &&
                         incoming().date == existing().date &&
                         incoming().createdAt == existing().createdAt;
        allow delete: if isSystemAdmin();
      }

      match /dailyNotes/{noteId} {
        allow read: if isSignedIn() && isOwnerOrShared(get(/databases/$(database)/documents/students/$(studentId)).data);
        allow list: if isSignedIn() && isOwnerOrShared(get(/databases/$(database)/documents/students/$(studentId)).data);
        allow create: if isSignedIn() && canLogData(get(/databases/$(database)/documents/students/$(studentId)).data) &&
                         isValidId(noteId) &&
                         incoming().keys().hasAll(['text', 'date', 'updatedAt']) &&
                         incoming().keys().size() == 3 &&
                         isValidDailyNote(incoming());
        allow update: if isSignedIn() && canLogData(get(/databases/$(database)/documents/students/$(studentId)).data) &&
                         isValidDailyNote(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['text', 'updatedAt']) &&
                         incoming().date == existing().date;
        allow delete: if false;
      }
    }

    match /personalGroups/{groupId} {
      allow read: if isSignedIn() && (existing() == null || existing().ownerId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid &&
                       isValidId(groupId) &&
                       hasAllKeys(incoming(), ['name', 'ownerId', 'studentIds', 'createdAt', 'updatedAt']) &&
                       isValidPersonalGroup(incoming());
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid &&
                       isValidPersonalGroup(incoming()) &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
